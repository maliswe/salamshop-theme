<!doctype html>
{% liquid
  assign text_direction = 'ltr'
  assign rtl_locales = 'ar,fa,he,ur' | split: ','
  if rtl_locales contains request.locale.iso_code
    assign text_direction = 'rtl'
  endif
%}
<html lang="{{ request.locale.iso_code }}" dir="{{ text_direction }}">
  <head>
    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    {% # Load and preload the critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}
    {% if template.name == 'index' %}
      {{ 'product-card.css' | asset_url | stylesheet_tag }}
      {{ 'homepage.css' | asset_url | stylesheet_tag }}
    {% endif %}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    {{ content_for_header }}
  </head>

  <body>
    <a class="skip-link" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>
    {% sections 'header-group' %}

    <main id="MainContent" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}
  </body>
</html>

{% if metafield != blank %}
  <details class="product-information__item" {{ block.shopify_attributes }}>
    <summary>{% if block.settings.heading != blank %}{{ block.settings.heading | escape }}{% else %}{{ fallback_heading | t }}{% endif %}</summary>
    <div class="product-information__content prose">{{ metafield | metafield_tag }}</div>
  </details>
{% endif %}

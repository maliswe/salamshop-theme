    {% when 'menu' %}<path d="M4 6h16M4 12h16M4 18h16"/>
    {% when 'link' %}<path d="M8 5h8l4 4v10H4V5h4Zm8 0v4h4M8 13h8m-8 3h6"/>
    {% when 'search' %}<circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4.5 4.5"/>
    {% when 'close' %}<path d="m6 6 12 12M6 18 18 6"/>
    {% when 'expand' %}<path d="M9 4H4v5m11-5h5v5M4 15v5h5m11-5v5h-5"/>
    {% when 'back' %}<path d="m10 5-7 7 7 7M3 12h17"/>
    {% when 'chevron' %}<path d="m6 9 6 6 6-6"/>
    {% when 'home' %}<path d="m3 11 9-7 9 7"/><path d="M5.5 10v10h13V10M9.5 20v-6h5v6"/>
    {% when 'grid' %}<rect x="4" y="4" width="6" height="6" rx="1"/><rect x="14" y="4" width="6" height="6" rx="1"/><rect x="4" y="14" width="6" height="6" rx="1"/><rect x="14" y="14" width="6" height="6" rx="1"/>
    {% when 'user' %}<circle cx="12" cy="8" r="4"/><path d="M4.5 21a7.5 7.5 0 0 1 15 0"/>
    {% when 'bag' %}<path d="M5 8h14l-1 12H6L5 8Z"/><path d="M9 9V6a3 3 0 0 1 6 0v3"/>
  {% endcase %}
</svg>

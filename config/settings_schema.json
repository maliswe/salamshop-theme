[
  {
    "name": "theme_info",
    "theme_name": "Skeleton",
    "theme_version": "0.1.0",
    "theme_author": "Shopify",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "header",
        "content": "t:general.fonts"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "work_sans_n4",
        "label": "t:design_system.body_font"
      },
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "label": "t:design_system.heading_font",
        "default": "work_sans_n4"
      },
      {
        "type": "range",
        "id": "base_font_size",
        "label": "t:design_system.base_font_size",
        "min": 16,
        "max": 20,
        "step": 1,
        "unit": "px",
        "default": 16
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "80rem",
            "label": "t:design_system.width_standard"
          },
          {
            "value": "90rem",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "110rem",
            "label": "t:options.page_width.wide"
          }
        ],
        "default": "80rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 20
      },
      {
        "type": "range",
        "id": "section_spacing",
        "label": "t:design_system.section_spacing",
        "info": "t:design_system.section_spacing_info",
        "min": 0,
        "max": 120,
        "step": 4,
        "unit": "px",
        "default": 64
      }
    ]
  },
  {
    "name": "t:general.colors",
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "default": "#FFFCF7",
        "label": "t:labels.background"
      },
      {
        "type": "color",
        "id": "foreground_color",
        "default": "#292720",
        "label": "t:labels.foreground"
      },
      {
        "type": "color",
        "id": "surface_color",
        "label": "t:design_system.surface",
        "default": "#F3E9DF"
      },
      {
        "type": "color",
        "id": "secondary_surface_color",
        "label": "t:design_system.secondary_surface",
        "default": "#E6D5BC"
      },
      {
        "type": "color",
        "id": "accent_color",
        "label": "t:design_system.accent",
        "default": "#C9A76A"
      },
      {
        "type": "color",
        "id": "border_color",
        "label": "t:design_system.border",
        "default": "#DDD4C7"
      },
      {
        "type": "color",
        "id": "primary_color",
        "label": "t:design_system.primary",
        "default": "#9A6A22"
      },
      {
        "type": "color",
        "id": "on_primary_color",
        "label": "t:design_system.on_primary",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "primary_container_color",
        "label": "t:design_system.primary_container",
        "default": "#F3E9DF"
      },
      {
        "type": "color",
        "id": "on_primary_container_color",
        "label": "t:design_system.on_primary_container",
        "default": "#49391E"
      },
      {
        "type": "color",
        "id": "surface_low_color",
        "label": "t:design_system.surface_low",
        "default": "#FAF5ED"
      },
      {
        "type": "color",
        "id": "surface_high_color",
        "label": "t:design_system.surface_high",
        "default": "#E6D5BC"
      },
      {
        "type": "color",
        "id": "on_surface_variant_color",
        "label": "t:design_system.on_surface_variant",
        "default": "#625C52"
      },
      {
        "type": "color",
        "id": "outline_color",
        "label": "t:design_system.outline",
        "default": "#81796B"
      },
      {
        "type": "paragraph",
        "content": "t:design_system.contrast_info"
      }
    ]
  },
  {
    "name": "t:design_system.controls",
    "settings": [
      {
        "type": "color",
        "id": "button_primary_background",
        "label": "t:design_system.button_primary_background",
        "default": "#9A6A22"
      },
      {
        "type": "color",
        "id": "button_primary_text",
        "label": "t:design_system.button_primary_text",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "button_secondary_background",
        "label": "t:design_system.button_secondary_background",
        "default": "#F3E9DF"
      },
      {
        "type": "color",
        "id": "button_secondary_text",
        "label": "t:design_system.button_secondary_text",
        "default": "#49391E"
      },
      {
        "type": "range",
        "id": "button_corner_radius",
        "label": "t:design_system.button_radius",
        "min": 0,
        "max": 50,
        "step": 1,
        "unit": "px",
        "default": 50
      },
      {
        "type": "range",
        "id": "card_corner_radius",
        "label": "t:design_system.card_radius",
        "min": 0,
        "max": 32,
        "step": 1,
        "unit": "px",
        "default": 24
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 32,
        "step": 1,
        "unit": "px",
        "label": "t:labels.input_corner_radius",
        "default": 24
      },
      {
        "type": "select",
        "id": "shape_scale",
        "label": "t:design_system.shape_scale",
        "options": [
          { "value": "compact", "label": "t:design_system.shape_compact" },
          { "value": "soft", "label": "t:design_system.shape_soft" },
          { "value": "expressive", "label": "t:design_system.shape_expressive" }
        ],
        "default": "expressive"
      }
    ]
  },
  {
    "name": "t:navigation_settings.title",
    "settings": [
      {
        "type": "checkbox",
        "id": "show_bottom_navigation",
        "label": "t:navigation_settings.show_bottom_navigation",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_tablet_navigation_rail",
        "label": "t:navigation_settings.show_tablet_navigation_rail",
        "default": false
      },
      {
        "type": "link_list",
        "id": "bottom_navigation_menu",
        "label": "t:navigation_settings.bottom_navigation_menu",
        "info": "t:navigation_settings.bottom_navigation_info",
        "default": "main-menu"
      }
    ]
  },
  {
    "name": "t:design_system.brand",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "t:design_system.logo",
        "info": "t:design_system.logo_info"
      }
    ]
  },
  {
    "name": "t:search_settings.title",
    "settings": [
      {
        "type": "checkbox",
        "id": "predictive_search_enabled",
        "label": "t:search_settings.enabled",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "search_show_images",
        "label": "t:search_settings.images",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "search_show_prices",
        "label": "t:search_settings.prices",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "search_show_collections",
        "label": "t:search_settings.collections",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "search_show_queries",
        "label": "t:search_settings.queries",
        "default": true
      },
      {
        "type": "range",
        "id": "search_suggestion_limit",
        "label": "t:search_settings.limit",
        "info": "t:search_settings.limit_info",
        "min": 4,
        "max": 10,
        "step": 1,
        "default": 8
      }
    ]
  },
  {
    "name": "t:cart_settings.title",
    "settings": [
      {
        "type": "select",
        "id": "cart_behavior",
        "label": "t:cart_settings.behavior",
        "options": [
          { "value": "drawer", "label": "t:cart_settings.behavior_drawer" },
          { "value": "page", "label": "t:cart_settings.behavior_page" }
        ],
        "default": "drawer"
      },
      { "type": "url", "id": "cart_continue_shopping_link", "label": "t:cart_settings.continue_link" },
      { "type": "collection", "id": "cart_empty_collection", "label": "t:cart_settings.empty_collection" },
      { "type": "textarea", "id": "cart_empty_text", "label": "t:cart_settings.empty_text", "default": "t:cart_settings.empty_text_default" },
      { "type": "text", "id": "cart_empty_button_label", "label": "t:cart_settings.empty_button", "default": "t:cart_settings.empty_button_default" },
      { "type": "checkbox", "id": "cart_show_notes", "label": "t:cart_settings.show_notes", "default": true },
      { "type": "checkbox", "id": "cart_show_thumbnails", "label": "t:cart_settings.show_thumbnails", "default": true },
      { "type": "checkbox", "id": "cart_show_variant_details", "label": "t:cart_settings.show_variant_details", "default": true },
      { "type": "checkbox", "id": "show_floating_cart", "label": "t:cart_settings.show_floating_cart", "default": true },
      {
        "type": "select",
        "id": "cart_layout",
        "label": "t:cart_settings.layout",
        "options": [
          { "value": "comfortable", "label": "t:cart_settings.layout_comfortable" },
          { "value": "compact", "label": "t:cart_settings.layout_compact" }
        ],
        "default": "comfortable"
      }
    ]
  }
]

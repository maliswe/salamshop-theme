[
  {
    "name": "theme_info",
    "theme_name": "Skeleton",
    "theme_version": "0.1.0",
    "theme_author": "Shopify",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "header",
        "content": "t:general.fonts"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "work_sans_n4",
        "label": "t:design_system.body_font"
      },
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "label": "t:design_system.heading_font",
        "default": "serif"
      },
      {
        "type": "range",
        "id": "base_font_size",
        "label": "t:design_system.base_font_size",
        "min": 16,
        "max": 20,
        "step": 1,
        "unit": "px",
        "default": 16
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "80rem",
            "label": "t:design_system.width_standard"
          },
          {
            "value": "90rem",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "110rem",
            "label": "t:options.page_width.wide"
          }
        ],
        "default": "80rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 20
      },
      {
        "type": "range",
        "id": "section_spacing",
        "label": "t:design_system.section_spacing",
        "info": "t:design_system.section_spacing_info",
        "min": 0,
        "max": 120,
        "step": 4,
        "unit": "px",
        "default": 64
      }
    ]
  },
  {
    "name": "t:general.colors",
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "default": "#F7F3EC",
        "label": "t:labels.background"
      },
      {
        "type": "color",
        "id": "foreground_color",
        "default": "#252B29",
        "label": "t:labels.foreground"
      },
      {
        "type": "color",
        "id": "surface_color",
        "label": "t:design_system.surface",
        "default": "#FFFEFB"
      },
      {
        "type": "color",
        "id": "secondary_surface_color",
        "label": "t:design_system.secondary_surface",
        "default": "#E7DECF"
      },
      {
        "type": "color",
        "id": "accent_color",
        "label": "t:design_system.accent",
        "default": "#C9A76A"
      },
      {
        "type": "color",
        "id": "border_color",
        "label": "t:design_system.border",
        "default": "#DED8CD"
      },
      {
        "type": "paragraph",
        "content": "t:design_system.contrast_info"
      }
    ]
  },
  {
    "name": "t:design_system.controls",
    "settings": [
      {
        "type": "color",
        "id": "button_primary_background",
        "label": "t:design_system.button_primary_background",
        "default": "#252B29"
      },
      {
        "type": "color",
        "id": "button_primary_text",
        "label": "t:design_system.button_primary_text",
        "default": "#FFFEFB"
      },
      {
        "type": "color",
        "id": "button_secondary_background",
        "label": "t:design_system.button_secondary_background",
        "default": "#FFFEFB"
      },
      {
        "type": "color",
        "id": "button_secondary_text",
        "label": "t:design_system.button_secondary_text",
        "default": "#252B29"
      },
      {
        "type": "range",
        "id": "button_corner_radius",
        "label": "t:design_system.button_radius",
        "min": 0,
        "max": 32,
        "step": 1,
        "unit": "px",
        "default": 4
      },
      {
        "type": "range",
        "id": "card_corner_radius",
        "label": "t:design_system.card_radius",
        "min": 0,
        "max": 32,
        "step": 1,
        "unit": "px",
        "default": 8
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 10,
        "step": 1,
        "unit": "px",
        "label": "t:labels.input_corner_radius",
        "default": 4
      }
    ]
  },
  {
    "name": "t:design_system.brand",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "t:design_system.logo",
        "info": "t:design_system.logo_info"
      }
    ]
  },
  {
    "name": "t:search_settings.title",
    "settings": [
      {
        "type": "checkbox",
        "id": "predictive_search_enabled",
        "label": "t:search_settings.enabled",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "search_show_images",
        "label": "t:search_settings.images",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "search_show_prices",
        "label": "t:search_settings.prices",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "search_show_collections",
        "label": "t:search_settings.collections",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "search_show_queries",
        "label": "t:search_settings.queries",
        "default": true
      },
      {
        "type": "range",
        "id": "search_suggestion_limit",
        "label": "t:search_settings.limit",
        "info": "t:search_settings.limit_info",
        "min": 4,
        "max": 10,
        "step": 1,
        "default": 8
      }
    ]
  }
]

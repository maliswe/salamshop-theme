{{ 'collection-directory.css' | asset_url | stylesheet_tag }}

<div class="collections-directory">
  <header class="collections-directory__header">
    <h1>{{ section.settings.heading | escape }}</h1>
    {% if section.settings.description != blank %}<div class="prose">{{ section.settings.description }}</div>{% endif %}
  </header>
  {% paginate collections by 24 %}
    <div class="collections-directory__grid {{ section.settings.grid_item_width }}" style="--directory-gap: {{ section.settings.grid_gap }}px; --directory-ratio: {% if section.settings.image_ratio == 'portrait' %}4 / 5{% elsif section.settings.image_ratio == 'square' %}1{% else %}4 / 3{% endif %}; --directory-fit: {{ section.settings.image_fit }};">
      {% for collection in collections %}
        {% liquid
          assign category_image = collection.image
          for block in section.blocks
            if block.settings.collection.id == collection.id and block.settings.image != blank
              assign category_image = block.settings.image
              break
            endif
          endfor
          assign has_image = false
          if section.settings.show_images and category_image != blank
            assign has_image = true
          endif
        %}
        <a class="directory-card{% unless has_image %} directory-card--text{% endunless %}" href="{{ collection.url }}">
          {% if has_image %}
            <div class="directory-card__media">
              {{ category_image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '300, 450, 600, 900, 1200', sizes: '(min-width: 80rem) 400px, (min-width: 64rem) 30vw, (min-width: 30rem) 45vw, 100vw', alt: category_image.alt | default: collection.title | escape }}
            </div>
          {% endif %}
          <div class="directory-card__content">
            <h2>{{ collection.title | escape }}</h2>
            {% if section.settings.show_product_count %}<p class="directory-card__count">{{ 'collection_page.products_count' | t: count: collection.all_products_count }}</p>{% endif %}
            {% if collection.description != blank %}<p class="directory-card__description">{{ collection.description | strip_html | truncatewords: 20 | escape }}</p>{% endif %}
            <span class="directory-card__action">{{ 'collections.explore' | t }} <span aria-hidden="true">→</span></span>
          </div>
        </a>
      {% else %}
        <p>{{ 'collections.empty' | t }}</p>
      {% endfor %}
    </div>
    {% if paginate.pages > 1 %}
      <nav class="directory-pagination" aria-label="{{ 'pagination.label' | t | escape }}">
        {% assign previous_label = 'pagination.previous' | t %}
        {% assign next_label = 'pagination.next' | t %}
        {{ paginate | default_pagination: previous: previous_label, next: next_label }}
      </nav>
    {% endif %}
  {% endpaginate %}
</div>

{% schema %}
{
  "name": "t:general.collections_grid",
  "settings": [
    { "type": "text", "id": "heading", "label": "t:homepage.common.heading", "default": "t:collections_directory.heading" },
    { "type": "richtext", "id": "description", "label": "t:homepage.common.description" },
    { "type": "checkbox", "id": "show_images", "label": "t:collections_directory.show_images", "default": true },
    { "type": "checkbox", "id": "show_product_count", "label": "t:collection_page.show_product_count", "default": true },
    { "type": "select", "id": "image_ratio", "label": "t:homepage.products.image_ratio", "options": [{ "value": "landscape", "label": "t:collections_directory.landscape" }, { "value": "square", "label": "t:homepage.options.square" }, { "value": "portrait", "label": "t:homepage.options.portrait" }], "default": "landscape" },
    { "type": "select", "id": "image_fit", "label": "t:collections_directory.image_fit", "options": [{ "value": "cover", "label": "t:homepage.products.fit_cover" }, { "value": "contain", "label": "t:homepage.products.fit_contain" }], "default": "cover" },
    { "type": "select", "id": "grid_item_width", "label": "t:collections_directory.density", "options": [{ "value": "collections--compact", "label": "t:homepage.products.density_compact" }, { "value": "collections--full", "label": "t:homepage.products.density_comfortable" }], "default": "collections--full" },
    { "type": "range", "id": "grid_gap", "label": "t:labels.grid_gap", "min": 0, "max": 50, "step": 5, "unit": "px", "default": 20 }
  ],
  "blocks": [{ "type": "image_override", "name": "t:collections_directory.image_override", "settings": [
    { "type": "collection", "id": "collection", "label": "t:homepage.common.collection" },
    { "type": "image_picker", "id": "image", "label": "t:homepage.common.image" }
  ] }],
  "presets": [{ "name": "t:general.collections_grid" }]
}
{% endschema %}

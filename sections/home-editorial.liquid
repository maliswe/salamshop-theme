{% liquid
  assign background = settings.background_color
  if section.settings.background == 'surface'
    assign background = settings.surface_color
  elsif section.settings.background == 'secondary'
    assign background = settings.secondary_surface_color
  endif
%}

{% style %}
  #shopify-section-{{ section.id }} { background: {{ background }}; }
  #shopify-section-{{ section.id }} .home-editorial { --home-editorial-background: {{ background }}; }
{% endstyle %}

<section class="home-section home-editorial home-editorial--image-{{ section.settings.image_position }}" aria-labelledby="HomeEditorial-{{ section.id }}">
  <div class="home-section__inner home-editorial__inner">
    <div class="home-editorial__media" aria-hidden="true">
      {% if section.settings.image != blank %}
        {{ section.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '480, 720, 960, 1200, 1600', sizes: '(min-width: 48rem) 55vw, 100vw', alt: '' }}
      {% else %}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'home-placeholder-svg' }}
      {% endif %}
    </div>

    <div class="home-editorial__content">
      {% if section.settings.eyebrow != blank %}<p class="home-section__eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      <h2 id="HomeEditorial-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      {% if section.settings.description != blank %}<div class="home-editorial__text">{{ section.settings.description }}</div>{% endif %}
      {% if section.settings.button_label != blank and section.settings.button_link != blank %}
        <p><a class="button{% if section.settings.button_style == 'secondary' %} button--secondary{% endif %}" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }}</a></p>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:homepage.editorial.name",
  "class": "home-section-wrapper",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "t:homepage.common.image" },
    { "type": "text", "id": "eyebrow", "label": "t:homepage.common.eyebrow", "default": "t:homepage.defaults.editorial_eyebrow" },
    { "type": "text", "id": "heading", "label": "t:homepage.common.heading", "default": "t:homepage.defaults.editorial_heading" },
    { "type": "richtext", "id": "description", "label": "t:homepage.common.description", "default": "t:homepage.defaults.editorial_description" },
    { "type": "text", "id": "button_label", "label": "t:homepage.common.button_label", "default": "t:homepage.defaults.discover_more" },
    { "type": "url", "id": "button_link", "label": "t:homepage.common.button_link" },
    {
      "type": "select", "id": "button_style", "label": "t:homepage.editorial.button_style",
      "options": [{ "value": "primary", "label": "t:general.primary" }, { "value": "secondary", "label": "t:general.secondary" }], "default": "primary"
    },
    { "type": "header", "content": "t:homepage.common.layout" },
    {
      "type": "select", "id": "image_position", "label": "t:homepage.editorial.image_position",
      "options": [{ "value": "left", "label": "t:options.alignment.left" }, { "value": "right", "label": "t:options.alignment.right" }], "default": "left"
    },
    {
      "type": "select", "id": "background", "label": "t:homepage.common.background",
      "options": [
        { "value": "default", "label": "t:homepage.options.background_default" },
        { "value": "surface", "label": "t:homepage.options.background_surface" },
        { "value": "secondary", "label": "t:homepage.options.background_secondary" }
      ], "default": "secondary"
    }
  ],
  "presets": [{ "name": "t:homepage.editorial.name" }]
}
{% endschema %}

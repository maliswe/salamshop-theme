{% comment %}
  This section is used in the blog template to render the blog page listing all
  articles within a blog.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/blog
{% endcomment %}

{{ 'secondary.css' | asset_url | stylesheet_tag }}

<div class="secondary-page section">
  <header class="secondary-page__header"><h1>{{ blog.title | escape }}</h1></header>
  {% paginate blog.articles by 9 %}
    <div class="article-list">
      {% for article in blog.articles %}
        <article class="article-card">
          {% if article.image %}
            <a class="article-card__image" href="{{ article.url }}" tabindex="-1" aria-hidden="true">
              {{ article.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '360, 540, 720, 960, 1200', sizes: '(min-width: 64rem) 30vw, (min-width: 40rem) 45vw, 100vw', alt: article.image.alt | default: article.title | escape }}
            </a>
          {% endif %}
          <div class="article-card__content">
            <h2><a href="{{ article.url }}">{{ article.title | escape }}</a></h2>
            {% assign date = article.published_at | time_tag: format: 'date' %}
            <p class="article-card__meta">{{ 'blog.article_metadata_html' | t: date: date, author: article.author }}</p>
            {% assign article_summary = article.excerpt | default: article.content %}
            <p>{{ article_summary | strip_html | truncatewords: 30 }}</p>
          </div>
        </article>
      {% else %}
        <p>{{ 'blog.empty' | t }}</p>
      {% endfor %}
    </div>

    {%- if paginate.pages > 1 -%}
      <nav class="secondary-pagination" aria-label="{{ 'pagination.label' | t | escape }}">
        {% assign previous_label = 'pagination.previous' | t %}
        {% assign next_label = 'pagination.next' | t %}
        {{- paginate | default_pagination: previous: previous_label, next: next_label -}}
      </nav>
    {%- endif -%}
  {% endpaginate %}
</div>

{% schema %}
{
  "name": "t:general.blog",
  "settings": []
}
{% endschema %}

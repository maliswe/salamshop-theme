{% comment %}
  This section is used in the password template to render landing page shown
  when password protection is applied to a store.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/password
{% endcomment %}

{{ 'secondary.css' | asset_url | stylesheet_tag }}

<div class="secondary-page password-page section">
  <div class="password-page__content">
    <h1>{{ 'password.title' | t }}</h1>
    {% if shop.password_message %}<div class="prose">{{ shop.password_message }}</div>{% endif %}

    {% form 'storefront_password' %}
      {% if form.errors %}<div role="alert">{{ form.errors | default_errors }}</div>{% endif %}
      <label for="password-input">{{ 'password.password' | t }}</label>
      <input type="password" name="password" id="password-input" autocomplete="current-password" required{% if form.errors %} aria-invalid="true"{% endif %}>
      <button type="submit">{{ 'password.enter' | t }}</button>
    {% endform %}
  </div>
</div>

{% schema %}
{
  "name": "t:general.password",
  "settings": []
}
{% endschema %}

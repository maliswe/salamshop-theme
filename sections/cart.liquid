{{ 'cart.css' | asset_url | stylesheet_tag }}

<cart-page class="cart-page cart-page--{{ settings.cart_layout }} section" data-cart-section data-section-id="{{ section.id }}">
  <div class="container">
    <header class="cart-page__header">
      <div>
        <p class="cart-page__eyebrow">SalamShop</p>
        <h1>{{ 'cart.title' | t }}</h1>
      </div>
      {% unless cart.empty? %}<p>{{ 'cart.item_count' | t: count: cart.item_count }}</p>{% endunless %}
    </header>

    <div class="cart-status" data-cart-status role="status" aria-live="polite"></div>
    <div class="form-message form-message--error cart-error" data-cart-error role="alert" hidden></div>

    {% if cart.empty? %}
      {% render 'cart-empty' %}
    {% else %}
      <form class="cart-page__form" action="{{ routes.cart_url }}" method="post" id="CartForm-{{ section.id }}">
        <div class="cart-page__items">
          {% for item in cart.items %}{% render 'cart-line-item', item: item, index: forloop.index, context: 'page' %}{% endfor %}
          <button class="button button--secondary cart-page__update" type="submit" name="update">{{ 'cart.update' | t }}</button>
        </div>

        <aside class="cart-page__aside" aria-label="{{ 'cart.summary' | t | escape }}">
          {% if settings.cart_show_notes %}
            <div class="cart-note">
              <label for="CartNote-{{ section.id }}">{{ 'cart.note' | t }}</label>
              <textarea id="CartNote-{{ section.id }}" name="note" rows="4" placeholder="{{ 'cart.note_placeholder' | t | escape }}">{{ cart.note | escape }}</textarea>
            </div>
          {% endif %}
          {% render 'cart-summary' %}
          {% liquid
            assign continue_url = settings.cart_continue_shopping_link
            if continue_url == blank and settings.cart_empty_collection != blank
              assign continue_url = settings.cart_empty_collection.url
            endif
            if continue_url == blank
              assign continue_url = routes.all_products_collection_url
            endif
          %}
          <a class="cart-continue" href="{{ continue_url }}">{{ 'cart.continue_shopping' | t }}</a>
        </aside>
      </form>
    {% endif %}
  </div>
</cart-page>

{% schema %}
{
  "name": "t:cart_page.name",
  "settings": [],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}

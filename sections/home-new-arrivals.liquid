{% liquid
  assign arrivals_collection = section.settings.collection
  assign heading = section.settings.heading
  if heading == blank and arrivals_collection != blank
    assign heading = arrivals_collection.title
  endif
%}

<section class="home-section home-products" aria-labelledby="HomeArrivals-{{ section.id }}">
  <div class="home-section__inner">
    <div class="home-section__header">
      <div class="home-section__heading-group">
        {% if section.settings.eyebrow != blank %}<p class="home-section__eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
        <h2 id="HomeArrivals-{{ section.id }}">{{ heading | escape }}</h2>
        {% if section.settings.description != blank %}<div class="prose">{{ section.settings.description }}</div>{% endif %}
      </div>
      {% if section.settings.show_view_all and arrivals_collection != blank %}
        <a class="home-section__action" href="{{ arrivals_collection.url }}">{{ 'homepage.view_all' | t }}</a>
      {% endif %}
    </div>

    {% render 'product-grid', collection: arrivals_collection, limit: section.settings.product_limit, columns_desktop: section.settings.columns_desktop, columns_mobile: section.settings.columns_mobile, image_ratio: section.settings.image_ratio %}
  </div>
</section>

{% schema %}
{
  "name": "t:homepage.new_arrivals.name",
  "class": "home-section-wrapper",
  "settings": [
    { "type": "collection", "id": "collection", "label": "t:homepage.common.collection" },
    { "type": "text", "id": "eyebrow", "label": "t:homepage.common.eyebrow", "default": "t:homepage.defaults.arrivals_eyebrow" },
    { "type": "text", "id": "heading", "label": "t:homepage.common.heading", "default": "t:homepage.defaults.arrivals_heading" },
    { "type": "richtext", "id": "description", "label": "t:homepage.common.description" },
    { "type": "checkbox", "id": "show_view_all", "label": "t:homepage.products.show_view_all", "default": true },
    { "type": "header", "content": "t:homepage.common.layout" },
    { "type": "range", "id": "product_limit", "label": "t:homepage.products.product_limit", "min": 2, "max": 12, "step": 1, "default": 4 },
    {
      "type": "select", "id": "columns_mobile", "label": "t:homepage.products.columns_mobile",
      "options": [{ "value": "1", "label": "1" }, { "value": "2", "label": "2" }], "default": "2"
    },
    {
      "type": "select", "id": "columns_desktop", "label": "t:homepage.products.columns_desktop",
      "options": [{ "value": "2", "label": "2" }, { "value": "3", "label": "3" }, { "value": "4", "label": "4" }, { "value": "5", "label": "5" }], "default": "4"
    },
    {
      "type": "select", "id": "image_ratio", "label": "t:homepage.products.image_ratio",
      "options": [{ "value": "portrait", "label": "t:homepage.options.portrait" }, { "value": "square", "label": "t:homepage.options.square" }], "default": "portrait"
    }
  ],
  "presets": [{ "name": "t:homepage.new_arrivals.name" }]
}
{% endschema %}

{% liquid
  assign hero_image = section.settings.image
  assign mobile_image = section.settings.mobile_image
  assign hero_image = hero_image | default: mobile_image
  assign text_color = section.settings.text_color
  assign loading_value = 'eager'
  assign alignment_items = 'start'
  if section.settings.text_alignment == 'center'
    assign alignment_items = 'center'
  elsif section.settings.text_alignment == 'right'
    assign alignment_items = 'end'
  endif
%}

{% style %}
  #shopify-section-{{ section.id }} { padding-block: 0; }
  #shopify-section-{{ section.id }} .home-hero {
    --home-hero-height-mobile: {{ section.settings.height_mobile }}svh;
    --home-hero-height-desktop: {{ section.settings.height_desktop }}svh;
    --home-hero-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --home-hero-text: {{ text_color }};
    --home-hero-align: {{ section.settings.text_alignment }};
    --home-hero-items: {{ alignment_items }};
    --home-hero-vertical: {{ section.settings.content_position }};
    --home-hero-focal-point: {{ hero_image.presentation.focal_point | default: 'center' }};
    --home-hero-mobile-focal-point: {{ mobile_image.presentation.focal_point | default: hero_image.presentation.focal_point | default: 'center' }};
  }
{% endstyle %}

<section class="home-section home-hero home-hero--{{ section.settings.height_mode }}{% if hero_image == blank %} home-hero--empty{% endif %} full-width"{% if section.settings.heading != blank %} aria-labelledby="HomeHero-{{ section.id }}"{% endif %}>
  <div class="home-hero__media" aria-hidden="true">
    {% if hero_image != blank %}
      <picture>
        {% if mobile_image != blank %}
          <source
            media="(max-width: 47.999rem)"
            srcset="{{ mobile_image | image_url: width: 480 }} 480w, {{ mobile_image | image_url: width: 750 }} 750w, {{ mobile_image | image_url: width: 960 }} 960w"
            sizes="100vw"
          >
        {% endif %}
        {{ hero_image | image_url: width: 2400 | image_tag: loading: loading_value, fetchpriority: 'high', widths: '750, 1100, 1500, 2000, 2400', sizes: '100vw', alt: '' }}
      </picture>
    {% else %}
      <div class="home-hero__placeholder"></div>
    {% endif %}
  </div>
  <div class="home-hero__overlay" aria-hidden="true"></div>

  <div class="home-hero__content-wrap">
    <div class="home-hero__content">
      {% if section.settings.eyebrow != blank %}<p class="home-section__eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      {% if section.settings.heading != blank %}<h1 id="HomeHero-{{ section.id }}" class="home-hero__title">{{ section.settings.heading | escape }}</h1>{% endif %}
      {% if section.settings.description != blank %}<div class="home-hero__description">{{ section.settings.description }}</div>{% endif %}
      {% if section.settings.primary_label != blank or section.settings.secondary_label != blank %}
        <div class="home-hero__actions">
          {% if section.settings.primary_label != blank and section.settings.primary_link != blank %}
            <a class="button" href="{{ section.settings.primary_link }}">{{ section.settings.primary_label | escape }}<span aria-hidden="true"> →</span></a>
          {% endif %}
          {% if section.settings.secondary_label != blank and section.settings.secondary_link != blank %}
            <a class="button button--secondary" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label | escape }}</a>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:homepage.hero.name",
  "class": "home-section-wrapper",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "t:homepage.hero.image" },
    { "type": "image_picker", "id": "mobile_image", "label": "t:homepage.hero.mobile_image", "info": "t:homepage.hero.mobile_image_info" },
    { "type": "text", "id": "eyebrow", "label": "t:homepage.common.eyebrow", "default": "t:homepage.defaults.hero_eyebrow" },
    { "type": "text", "id": "heading", "label": "t:homepage.common.heading", "default": "t:homepage.defaults.hero_heading" },
    { "type": "richtext", "id": "description", "label": "t:homepage.common.description", "default": "t:homepage.defaults.hero_description" },
    { "type": "header", "content": "t:homepage.common.primary_action" },
    { "type": "text", "id": "primary_label", "label": "t:homepage.common.button_label", "default": "t:homepage.defaults.explore" },
    { "type": "url", "id": "primary_link", "label": "t:homepage.common.button_link" },
    { "type": "header", "content": "t:homepage.common.secondary_action" },
    { "type": "text", "id": "secondary_label", "label": "t:homepage.common.button_label" },
    { "type": "url", "id": "secondary_link", "label": "t:homepage.common.button_link" },
    { "type": "header", "content": "t:homepage.common.layout" },
    { "type": "select", "id": "height_mode", "label": "t:homepage.hero.height_mode", "info": "t:homepage.hero.height_mode_info", "options": [{ "value": "editorial", "label": "t:homepage.hero.height_editorial" }, { "value": "custom", "label": "t:homepage.hero.height_custom" }], "default": "editorial" },
    {
      "type": "text_alignment",
      "id": "text_alignment",
      "label": "t:homepage.common.text_alignment",
      "default": "left"
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "t:homepage.hero.content_position",
      "options": [
        { "value": "start", "label": "t:homepage.options.top" },
        { "value": "center", "label": "t:homepage.options.middle" },
        { "value": "end", "label": "t:homepage.options.bottom" }
      ],
      "default": "center"
    },
    { "type": "range", "id": "height_mobile", "label": "t:homepage.hero.height_mobile", "min": 55, "max": 90, "step": 5, "unit": "%", "default": 70 },
    { "type": "range", "id": "height_desktop", "label": "t:homepage.hero.height_desktop", "min": 55, "max": 90, "step": 5, "unit": "%", "default": 75 },
    { "type": "range", "id": "overlay_opacity", "label": "t:homepage.hero.overlay", "min": 0, "max": 70, "step": 5, "unit": "%", "default": 25 },
    { "type": "color", "id": "text_color", "label": "t:homepage.hero.text_color", "default": "#FFFEFB" }
  ],
  "presets": [{ "name": "t:homepage.hero.name" }]
}
{% endschema %}

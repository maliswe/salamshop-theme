{% comment %}
  This section is used in the search template to render search results for
  products, articles, and pages.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/search
{% endcomment %}

<div class="search-page">
  <h1>{% if search.performed %}{{ 'discovery.results_heading' | t: terms: search.terms | escape }}{% else %}{{ 'search.title' | t }}{% endif %}</h1>
  {% capture search_id %}results-{{ section.id }}{% endcapture %}
  {% render 'header-search', id: search_id %}
  {% if search.performed %}
    {% if search.results_count == 0 %}
      <div class="stack">
        <p>{{ 'search.no_results_html' | t: terms: search.terms | escape }}</p>
        <p>{{ 'discovery.try_another' | t }}</p>
      </div>
    {% else %}
      <p>{{ 'search.results_for_html' | t: terms: search.terms, count: search.results_count | escape }}</p>
      {% paginate search.results by 20 %}
        <div class="search-results">
          {% for result in search.results %}
            <article class="product-card">
              <a class="search-result-link" href="{{ result.url | escape }}">
                {% if result.object_type == 'product' %}
                  {% render 'search-product', product: result, compact: false %}
                {% else %}
                  {% assign result_image = result.featured_image | default: result.image %}
                  {% if result_image and settings.search_show_images %}{{ result_image | image_url: width: 480 | image_tag: loading: 'lazy', alt: '' }}{% endif %}
                  <span class="search-product-title">{{ result.title | escape }}</span>
                  <span>{{ result.content | strip_html | truncatewords: 25 | escape }}</span>
                {% endif %}
              </a>
            </article>
          {% endfor %}
        </div>
        {% if paginate.pages > 1 %}
          <nav class="search-pagination" aria-label="{{ 'discovery.pagination' | t | escape }}">
            {% assign previous_label = 'pagination.previous' | t %}
            {% assign next_label = 'pagination.next' | t %}
            {{ paginate | default_pagination: previous: previous_label, next: next_label }}
          </nav>
        {% endif %}
      {% endpaginate %}
    {% endif %}
  {% endif %}
</div>

{% schema %}
{
  "name": "t:general.search",
  "settings": []
}
{% endschema %}

{% comment %}
  This section is used in the 404 template to render page shown when customers
  enter an invalid store URL.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/404
{% endcomment %}

{{ 'secondary.css' | asset_url | stylesheet_tag }}

<div class="secondary-page empty-page section">
  <div class="empty-page__content">
    <p class="home-section__eyebrow" aria-hidden="true">404</p>
    <h1>{{ '404.title' | t }}</h1>
    <p>{{ '404.not_found' | t }}</p>
    <a class="button" href="{{ routes.all_products_collection_url }}">{{ '404.back_to_shopping' | t }}</a>
  </div>
</div>

{% schema %}
{
  "name": "t:general.404",
  "settings": []
}
{% endschema %}

{% comment %}
  This section is used in the page template to render store pages like About us
  or Contact us.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/page
{% endcomment %}

{{ 'secondary.css' | asset_url | stylesheet_tag }}

<article class="secondary-page section">
  <header class="secondary-page__header">
    <h1>{{ page.title | escape }}</h1>
  </header>
  <div class="secondary-page__content rte">
    {{ page.content }}
  </div>
</article>

{% schema %}
{
  "name": "t:general.page",
  "settings": []
}
{% endschema %}
